# EmpireVu Mobile — build-time configuration. Copy to .env and fill in.
# These values are compiled into the app bundle, so only public values belong here.

# Origin of the deployed EmpireVu hub that serves /api/* (no trailing slash).
# app.empirevu.com is the hub; empirevu.com is the marketing site and has no API.
VITE_API_BASE_URL=https://app.empirevu.com

# Same public Supabase project values the web app uses.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Product name, support address and wordmark accent shown in the app (mobile/src/lib/brand.ts).
# Optional — defaults to CrankLeads. Same names and meaning as the web app's VITE_PLATFORM_*
# (docs/branding.md). Does NOT change the bundle id or the native home-screen name.
VITE_PLATFORM_BRAND_NAME=
VITE_PLATFORM_SUPPORT_EMAIL=
VITE_PLATFORM_BRAND_ACCENT_HSL=
