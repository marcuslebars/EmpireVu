# EmpireVu Mobile — build-time configuration. Copy to .env and fill in.
# These values are compiled into the app bundle, so only public values belong here.

# Origin of the deployed EmpireVu hub that serves /api/* (no trailing slash).
# app.everdoer.com is the hub (app.empirevu.com still works); everdoer.com is the marketing site and has no API.
VITE_API_BASE_URL=https://app.everdoer.com

# Same public Supabase project values the web app uses.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
