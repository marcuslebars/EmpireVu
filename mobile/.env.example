# Everdoer Mobile — build-time configuration. Copy to .env and fill in.
# These values are compiled into the app bundle, so only public values belong here.

# Origin that serves the Everdoer /api/* (no trailing slash). Defaults to https://api.everdoer.com
# when unset. api.everdoer.com is an alias of the hub (app.everdoer.com serves the same /api/*);
# everdoer.com is the marketing site and has no API.
VITE_API_BASE_URL=https://api.everdoer.com

# Same public Supabase project values the web app uses.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
