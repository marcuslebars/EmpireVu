# EmpireVu environment variables.
# Copy to .env.local for local development. NEVER commit real values.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used solely by the sanctioned service-role paths
# (lead intake, public booking, Telnyx voice routes).
SUPABASE_SERVICE_ROLE_KEY=
# [gen:types] Remote type generation without Docker: `npm run gen:types:remote`
# reads these from .env.local (git-ignored) and runs against the hosted project.
# PROJECT_REF is the dashboard's Reference ID; generate ACCESS_TOKEN in Supabase →
# Account → Access Tokens. Tooling-only — not read by the app at runtime.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ─── Mobile app (iOS + Android) ──────────────────────────────────────────────
# See mobile/README.md. All optional: without push credentials no pushes are sent.
# Extra origins allowed to call /api cross-origin with a Bearer token, comma-separated.
# capacitor://localhost and https://localhost are always allowed.
MOBILE_APP_ORIGINS=
# APNs token auth (.p8). APNS_PRIVATE_KEY is the key file contents; "\n" escapes are OK.
# APNS_PRODUCTION=true for TestFlight/App Store builds, false for Xcode debug builds.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.empirevu.app
APNS_PRODUCTION=true
# Firebase service-account JSON (single line) for Android pushes via FCM HTTP v1.
FCM_SERVICE_ACCOUNT_JSON=

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL, e.g. https://empirevu.com. Used to build self-booking links, and by
# [web] /api/public/forms/* to recognise the hosted lead page as same-origin (no new var).
# Must be set on BOTH the web and worker services.
APP_BASE_URL=
# Optional API origin for Retell readiness checks when the API and app hosts differ.
# Set on the API and any digest worker; defaults to APP_BASE_URL for single-host deployments.
# Example: https://api.empirevu.com. Does not change customer-facing links.
RETELL_PUBLIC_BASE_URL=
# Defaults to America/Toronto when unset. [worker] also uses it as the OPERATOR's timezone for
# the daily operator health email (07:30 send time + report date).
BUSINESS_TIMEZONE=

# ─── Lead intake ─────────────────────────────────────────────────────────────
# Organization slug that inbound leads are pinned to (default: a1-group).
LEAD_INTAKE_ORG_SLUG=

# ─── Abuse controls (Task 5) ─────────────────────────────────────────────────
# Cloudflare Turnstile protects the public booking + waitlist forms. Both keys come
# from ONE Turnstile widget (dash.cloudflare.com → Turnstile → Add widget); add every
# form hostname to that widget (app.empirevu.com AND empirevu.com/www).
#
# FAIL-OPEN UNTIL SET: with TURNSTILE_SECRET_KEY unset, verification is skipped (a
# warning is logged) so nothing breaks before you provision it. Once set, a missing or
# invalid token is rejected — so render the widget (VITE_TURNSTILE_SITE_KEY) on BOTH
# forms, including the empirevu.com waitlist (separate empirevu-site repo), BEFORE you
# set the secret here. Rate limiting + honeypot + timing protect the forms regardless.
#
# Website lead forms (/f/:key, /embed/v1.js): instant-reply SMS / auto-call automations
# only run for a form lead whose Turnstile check ACTUALLY verified — set the pair below in
# production. Without them form leads still land + alert the owner (no paid actions).
# Client-safe site key ([web] SPA booking form). VITE_-prefixed by design.
VITE_TURNSTILE_SITE_KEY=
# Server-only secret ([web]). NEVER VITE_/NEXT_PUBLIC_ prefixed.
TURNSTILE_SECRET_KEY=
# SMS throttle for unauthenticated-sourced triggers (public form / public booking) in the
# paid-action guard — read where workflow actions execute: [worker] (workflow-event-worker)
# and [web] (workflow run-now / run-test routes). Defaults shown.
# Hours before the same phone can get another such SMS:
UNAUTH_SMS_COOLDOWN_HOURS=24
# Max sent SMS (all sources) per company in 24h for such a trigger to still send:
UNAUTH_SMS_DAILY_CAP=100
# The DB-backed rate limiter needs no env (it uses SUPABASE_SERVICE_ROLE_KEY). The
# per-org daily cap on unauthenticated-sourced outbound AI calls defaults to 20 and is
# overridden per org via feature_flags.limit_value for feature `public_outbound_calls_daily`.

# ─── Telnyx Voice AI Assistant ───────────────────────────────────────────────
# See docs/telnyx-integration.md for the endpoint URLs and portal setup.
#
# Shared secret Telnyx must send as the `x-empirevu-telnyx-secret` header on all
# four endpoints. Requests without an exact match are rejected with 401.
TELNYX_WEBHOOK_SECRET=
# Company (brand) UUID used when the dialled number isn't mapped in
# `telnyx_numbers`. Without it, an unmapped number resolves to no tenant.
TELNYX_DEFAULT_TENANT_ID=
# `true` logs full raw request payloads so field names can be confirmed on first
# deploy. Turn OFF afterwards — payloads contain caller PII.
TELNYX_DEBUG_PAYLOADS=false
# Booking deposit. A BUSINESS RULE, not pricing-engine output — the engine has no
# deposit concept. Flat cents (default 10000 = $100); TELNYX_DEPOSIT_PERCENT wins
# if both are set.
TELNYX_DEPOSIT_CENTS=10000
TELNYX_DEPOSIT_PERCENT=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Required on BOTH web and worker (the ai_analyze workflow action runs on the worker).
ANTHROPIC_API_KEY=
# AI model per surface (Task 6) — env-overridable so a surface can move to a smaller,
# cheaper model without a code change. Defaults are the current values (claude-opus-5).
AI_MODEL_DRAFTS=
AI_MODEL_WORKFLOWS=
# [web] In-app Help assistant model (docs/help-assistant.md). Optional; defaults to the same model
# as the others. AI_PRICE_* below are shared by every surface, so cost estimates assume one model.
AI_MODEL_HELP=
# Reading receipt photos/PDFs into expenses (optional; defaults to the main model)
AI_MODEL_RECEIPTS=
# AI token pricing for usage cost ESTIMATES (USD per million tokens). Defaults are Opus
# 5 list price: input 5.00, output 25.00, cache-read 0.50, cache-write 6.25. If you
# point AI_MODEL_* at a cheaper model, set these to that model's rates too.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_CACHE_READ_PER_MTOK=
AI_PRICE_CACHE_WRITE_PER_MTOK=

# ─── Internal ops (Task 6) ───────────────────────────────────────────────────
# Bearer token gating the cross-tenant cost-vs-MRR report at GET /api/ops/tenant-costs
# (the app has no platform-admin identity, so this is token-gated like the waitlist
# admin read). Unset → the endpoint returns 503. Call with `Authorization: Bearer <token>`;
# `?format=csv` for a spreadsheet export.
OPS_ADMIN_TOKEN=

# ─── Voice (Cartesia / "Marina") ─────────────────────────────────────────────
# All three required. Needed on BOTH web (manual + quick call) and worker
# (the call_lead workflow action). CARTESIA_FROM_NUMBER_ID is the phone number's
# ID from your Cartesia account — not the phone number itself.
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=

# ─── Outbound email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
# Customer-facing sender for AI-drafted replies.
OUTBOUND_FROM_EMAIL=
OUTBOUND_REPLY_TO=
# Internal lead-notification sender/recipients.
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
# [web][worker] Platform/house-org owner inbox. Used for owner alerts and the digest ONLY for the
# house org (organizations.plan='internal' or slug=LEAD_INTAKE_ORG_SLUG, i.e. A1) when the company has
# no owner_email. Never used as another tenant's owner address or for the monthly scorecard.
# Also the OPERATOR inbox for CrankLeads notes ([billing-worker] new purchase / failure,
# [worker] "buyer stuck after 10 business days" from the setup follow-ups).
# [web] ALSO the operator inbox for in-app Help "Contact support" requests from ANY org
# (docs/help-assistant.md) — unset → requests are still saved in support_requests, no email.
# [worker] ALSO the recipient of the daily operator health email (docs/operator-health.md).
OWNER_EMAIL=

# ─── In-app Help assistant (docs/help-assistant.md) ──────────────────────────
# [web] ONLY. Daily caps on Help questions (rate_limit_buckets; no new service). Defaults 40 / 150.
# Fixed (not env): 6 questions/min per user; Contact support 5/day per user, 15/day per org.
HELP_ASK_DAILY_LIMIT_PER_USER=
HELP_ASK_DAILY_LIMIT_PER_ORG=

# ─── Monthly results scorecard ───────────────────────────────────────────────
# See docs/monthly-scorecard.md. Service tag:
#   [monthly-scorecard]  monthly email cron — railway.monthly-scorecard.json (npm run job:monthly-scorecard)
# That service ALSO needs (existing vars, no new values): NEXT_PUBLIC_SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, OUTBOUND_FROM_EMAIL (or LEAD_FROM_EMAIL),
# APP_BASE_URL (the "See your full results" link); optional OUTBOUND_REPLY_TO,
# BUSINESS_TIMEZONE. (OWNER_EMAIL is deliberately NOT used: scorecards go to the company/org owner.)
# [monthly-scorecard] ONLY. Platform brand shown as the email's sender display name and in
# its footer ("Sent by EmpireVu for <company>"). The client's own company name always comes
# from the companies table. Optional — defaults to EmpireVu. Read in exactly one place:
# src/server/services/monthly-scorecard/platform-brand.ts.
PLATFORM_BRAND_NAME=

# ─── Outbound SMS (Twilio)───────────────────────────────────────────────────
# All-or-nothing: SMS is disabled unless all three are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Missed-call catcher (Twilio voice; docs/missed-call-catcher.md) ─────────
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above are also used by [web] to buy/attach catcher
# numbers and to verify X-Twilio-Signature on /api/twilio/voice/*, and by [worker] for the
# send_sms text-back. A company with its own active Twilio number texts FROM that number;
# TWILIO_FROM_NUMBER is the fallback.
# [web, worker] Public origin Twilio calls back (webhook + TwiML callback URLs, signature
# check; the worker builds forwarding-test callback URLs from it). Defaults to APP_BASE_URL —
# set only when Twilio must reach a different host.
TWILIO_WEBHOOK_BASE_URL=
# [worker] Don't text the same caller back twice within this many minutes (0 = off). Default 10.
MISSED_CALL_TEXTBACK_WINDOW_MINUTES=10
# [web] Voicemail length cap in seconds (5–600). Default 120.
MISSED_CALL_VOICEMAIL_MAX_SECONDS=120
# [web] "true" turns on Twilio voicemail transcription (billed by Twilio per minute). Default off.
MISSED_CALL_TRANSCRIBE=false
# [web] <Say> voice for the greeting. Default Polly.Joanna.
TWILIO_SAY_VOICE=
# [web] Country catcher numbers are bought in (ISO code). Default CA.
TWILIO_NUMBER_COUNTRY=CA
# [web, worker] Forwarding verification (docs/missed-call-catcher.md → Forwarding verification).
# Optional platform "verifier" number (E.164; a Twilio number in the SAME account, never a
# catcher number or TWILIO_FROM_NUMBER) used as the caller ID of forwarding test calls.
# RECOMMENDED for production: a dedicated verifier makes the forwarded test leg unambiguous
# (detection matches ONLY From == the test caller ID; see the trade-off in the doc).
# Unset → each company's own catcher number is the caller ID. [web] places owner-triggered
# tests; [worker] places the scheduled weekly/daily retests (the worker also needs
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN and APP_BASE_URL or TWILIO_WEBHOOK_BASE_URL for that).
TWILIO_FORWARDING_TEST_FROM=

# ─── Worker ──────────────────────────────────────────────────────────────────
# Optional identifier for the workflow-event worker instance.
WORKFLOW_EVENT_WORKER_ID=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# See docs/billing.md and docs/go-live-phase-1.md for the full per-service setup.
# Phase 1 is TEST MODE only. Each var is tagged with the service(s) that consume
# it (traced from the code, not assumed):
#   [web]             the Next app          — railway.json (npm run start)
#   [billing-worker]  event processor       — railway.billing-worker.json (npm run worker:billing-events)
#   [reconcile]       nightly diff/alert    — railway.billing-reconcile.json (npm run job:billing-reconcile)
#
# SERVER-ONLY SECRETS — never prefix with VITE_/NEXT_PUBLIC_, never log, never
# import into the client bundle.

# [web] (webhook signature verify + checkout/portal API calls) and [reconcile]
# (lists subscriptions). NOT needed by [billing-worker] — it never constructs a
# Stripe client (it only reads the already-stored event payload).
STRIPE_SECRET_KEY=
# [web] ONLY. Webhook endpoint signing secret (whsec_...). `stripe listen` prints
# one for local dev; the dashboard endpoint has its own for prod.
STRIPE_WEBHOOK_SECRET=
# Client-safe. Not consumed anywhere in Phase 1 (no UI); documented for Phase 2.
# The ONLY Stripe key that may carry a VITE_/NEXT_PUBLIC_ prefix.
STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (price_...) — pricing lives in Stripe, never as amounts in
# code. [web] (checkout), [billing-worker] (map price->plan on subscription
# updates — required for correct upgrade/downgrade), [reconcile] (plan-drift check).
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_OPERATE=
STRIPE_PRICE_FRONT_DESK=
# [web] ONLY. Optional one-time setup-fee price ids (added to the first invoice).
# Leave blank to omit. Naming: STRIPE_SETUP_FEE_<PLAN>.
STRIPE_SETUP_FEE_LAUNCH=
STRIPE_SETUP_FEE_OPERATE=
STRIPE_SETUP_FEE_FRONT_DESK=

# [web] ONLY. Days a past_due subscription keeps paid features after its period
# end (grace). Read by getPastDueGraceDays() -> the gating helper (orgCan/orgLimit),
# which runs only in web API routes. Neither worker consumes it. Default 7.
BILLING_PAST_DUE_GRACE_DAYS=

# ─── CrankLeads purchase (docs/crankleads-purchase.md) ───────────────────────
# A business buys a CrankLeads tier on crankleads.com → Stripe Checkout → the billing worker
# provisions their EmpireVu org automatically. Prices live in Stripe (created by
# `npm run stripe:setup-crankleads`, which prints these lines) — never amounts in code.
#
# [web] (checkout line items) + [billing-worker] (price → plan on subscription events:
# Catch/Close → operate, Front Desk → front_desk) + [reconcile] (plan-drift check).
STRIPE_PRICE_CL_CATCH=
STRIPE_PRICE_CL_CLOSE=
STRIPE_PRICE_CL_FRONT_DESK=
# [web] ONLY. One-time setup-fee prices (first invoice only). Required — checkout answers 503
# for a tier whose monthly or setup price is unset.
STRIPE_SETUP_FEE_CL_CATCH=
STRIPE_SETUP_FEE_CL_CLOSE=
STRIPE_SETUP_FEE_CL_FRONT_DESK=
# [web] ONLY. Optional founding-client coupon id (setup fees only). Applied when the form sends
# founding=true AND the coupon is still valid in Stripe (exhausted → full price, never a failed sale).
# No promotion-code box: only this coupon can discount a CrankLeads checkout.
STRIPE_COUPON_CL_FOUNDING=
# [web] ONLY. "true" turns on Stripe Tax for CrankLeads Checkout. Default OFF — HST is a manual
# follow-up until Stripe Tax is registered for Ontario.
STRIPE_AUTOMATIC_TAX=
# [web] ONLY. Comma list of origins allowed to call POST /api/public/crankleads/checkout (CORS,
# no credentials). Default https://crankleads.com,https://www.crankleads.com
CRANKLEADS_SITE_ORIGINS=
# [web] ONLY. Where Stripe sends a buyer who cancels Checkout. Default https://crankleads.com/#pricing
CRANKLEADS_CANCEL_URL=
# [web] OPTIONAL. Stripe Checkout branding for CrankLeads purchases (the page shows CrankLeads,
# not the account's EmpireVu name/logo). Defaults: "CrankLeads",
# https://crankleads.com/brand/crankleads-logo.png (https only), #0c0f13, #a6ee2b (hex only).
CRANKLEADS_CHECKOUT_DISPLAY_NAME=
CRANKLEADS_CHECKOUT_LOGO_URL=
CRANKLEADS_CHECKOUT_BACKGROUND_COLOR=
CRANKLEADS_CHECKOUT_BUTTON_COLOR=
# [web, worker, billing-worker, monthly-scorecard] The CrankLeads app origin (no trailing slash).
# Every link a CrankLeads account's people get — welcome/set-password email, setup reminders,
# team invites, voicemail/digest/scorecard links, Stripe Checkout success/return URLs — uses
# it. Default https://app.crankleads.com. Must be a domain pointed at the web service AND listed
# in Supabase Auth → Redirect URLs (docs/crankleads-branding.md).
CRANKLEADS_APP_BASE_URL=
#
# [billing-worker] now provisions purchases, so it ALSO needs these EXISTING vars (same values
# as [web]): APP_BASE_URL (links in the welcome email), RESEND_API_KEY + OUTBOUND_FROM_EMAIL
# (welcome + operator emails; optional OUTBOUND_REPLY_TO), OWNER_EMAIL (operator copy of every
# purchase / failure), and TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM_NUMBER so the
# starter automations install ACTIVE (the worker never sends SMS itself — without them the
# SMS recipes install as drafts, exactly like a deployment without Twilio).
#
# [crankleads-sweep] Railway cron (railway.crankleads-sweep.json, every 15 min:
# `npm run job:crankleads-provision -- --stuck`) — no new vars; needs the same values as web for
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, APP_BASE_URL,
# RESEND_API_KEY, OUTBOUND_FROM_EMAIL, OWNER_EMAIL and TWILIO_*.
#
# Setup follow-ups (day 1/3/5/10 reminders + "you're live"; docs/crankleads-purchase.md) run in
# the EXISTING [worker] (workflow-event worker's scheduler pass) — no new service, no new vars.
# [worker] must have (existing vars): APP_BASE_URL (deep links + stop link), RESEND_API_KEY +
# OUTBOUND_FROM_EMAIL (reminder emails), TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN +
# TWILIO_FROM_NUMBER (reminder texts go FROM TWILIO_FROM_NUMBER), and OWNER_EMAIL (operator note).

# ─── Daily operator health email (docs/operator-health.md) ──────────────────
# [worker] ONLY (runs in the workflow-event worker's scheduler pass, ~07:30 BUSINESS_TIMEZONE,
# once per operator-local day). Emails OWNER_EMAIL only the accounts / things that need a human.
# Uses EXISTING [worker] vars: OWNER_EMAIL (recipient), APP_BASE_URL (links), BUSINESS_TIMEZONE
# (send time + report date; default America/Toronto), RESEND_API_KEY + OUTBOUND_FROM_EMAIL.
# Optional STRIPE_SECRET_KEY: only its sk_test_/live prefix is read, to point Stripe links at
# the test-mode dashboard; it is never sent anywhere.
# Default on whenever OWNER_EMAIL is set; set to false / 0 / off to stop the daily email.
OPERATOR_HEALTH_ENABLED=
# weekly (default) = a short "all clear" on Mondays when nothing needs you; never = silence.
OPERATOR_HEALTH_ALL_CLEAR=

# ─── Billing worker ──────────────────────────────────────────────────────────
# [billing-worker] ONLY (railway.billing-worker.json). All optional; defaults
# shown. The worker's REQUIRED env is NEXT_PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY (same Supabase values the existing workflow worker
# uses) plus the STRIPE_PRICE_* above — no Stripe secret key.
BILLING_EVENT_WORKER_ID=
BILLING_EVENT_WORKER_BATCH_SIZE=10
BILLING_EVENT_WORKER_POLL_MS=2000
BILLING_EVENT_WORKER_STALE_AFTER_SECONDS=900

# ── QuickBooks Online / Xero sync (docs/accounting-sync.md) [web + worker] ──
# 32 random bytes, base64: openssl rand -base64 32 (encrypts stored tokens; required)
ACCOUNTING_TOKEN_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox | production
QUICKBOOKS_ENVIRONMENT=sandbox
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
