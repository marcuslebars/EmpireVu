# EmpireVu environment variables.
# Copy to .env.local for local development. NEVER commit real values.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used solely by the sanctioned service-role paths
# (lead intake, public booking, Telnyx voice routes).
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL, e.g. https://empirevu.com. Used to build self-booking links.
# Must be set on BOTH the web and worker services.
APP_BASE_URL=
# Defaults to America/Toronto when unset.
BUSINESS_TIMEZONE=

# ─── Lead intake ─────────────────────────────────────────────────────────────
# Organization slug that inbound leads are pinned to (default: a1-group).
LEAD_INTAKE_ORG_SLUG=

# ─── Telnyx Voice AI Assistant ───────────────────────────────────────────────
# See docs/telnyx-integration.md for the endpoint URLs and portal setup.
#
# Shared secret Telnyx must send as the `x-empirevu-telnyx-secret` header on all
# four endpoints. Requests without an exact match are rejected with 401.
TELNYX_WEBHOOK_SECRET=
# Company (brand) UUID used when the dialled number isn't mapped in
# `telnyx_numbers`. Without it, an unmapped number resolves to no tenant.
TELNYX_DEFAULT_TENANT_ID=
# `true` logs full raw request payloads so field names can be confirmed on first
# deploy. Turn OFF afterwards — payloads contain caller PII.
TELNYX_DEBUG_PAYLOADS=false
# Booking deposit. A BUSINESS RULE, not pricing-engine output — the engine has no
# deposit concept. Flat cents (default 10000 = $100); TELNYX_DEPOSIT_PERCENT wins
# if both are set.
TELNYX_DEPOSIT_CENTS=10000
TELNYX_DEPOSIT_PERCENT=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Required on BOTH web and worker (the ai_analyze workflow action runs on the worker).
ANTHROPIC_API_KEY=

# ─── Voice (Cartesia / "Marina") ─────────────────────────────────────────────
# All three required. Needed on BOTH web (manual + quick call) and worker
# (the call_lead workflow action). CARTESIA_FROM_NUMBER_ID is the phone number's
# ID from your Cartesia account — not the phone number itself.
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=

# ─── Outbound email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
# Customer-facing sender for AI-drafted replies.
OUTBOUND_FROM_EMAIL=
OUTBOUND_REPLY_TO=
# Internal lead-notification sender/recipients.
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
OWNER_EMAIL=

# ─── Outbound SMS (Twilio) ───────────────────────────────────────────────────
# All-or-nothing: SMS is disabled unless all three are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Worker ──────────────────────────────────────────────────────────────────
# Optional identifier for the workflow-event worker instance.
WORKFLOW_EVENT_WORKER_ID=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# See docs/billing.md and docs/go-live-phase-1.md for the full per-service setup.
# Phase 1 is TEST MODE only. Each var is tagged with the service(s) that consume
# it (traced from the code, not assumed):
#   [web]             the Next app          — railway.json (npm run start)
#   [billing-worker]  event processor       — railway.billing-worker.json (npm run worker:billing-events)
#   [reconcile]       nightly diff/alert    — railway.billing-reconcile.json (npm run job:billing-reconcile)
#
# SERVER-ONLY SECRETS — never prefix with VITE_/NEXT_PUBLIC_, never log, never
# import into the client bundle.

# [web] (webhook signature verify + checkout/portal API calls) and [reconcile]
# (lists subscriptions). NOT needed by [billing-worker] — it never constructs a
# Stripe client (it only reads the already-stored event payload).
STRIPE_SECRET_KEY=
# [web] ONLY. Webhook endpoint signing secret (whsec_...). `stripe listen` prints
# one for local dev; the dashboard endpoint has its own for prod.
STRIPE_WEBHOOK_SECRET=
# Client-safe. Not consumed anywhere in Phase 1 (no UI); documented for Phase 2.
# The ONLY Stripe key that may carry a VITE_/NEXT_PUBLIC_ prefix.
STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (price_...) — pricing lives in Stripe, never as amounts in
# code. [web] (checkout), [billing-worker] (map price->plan on subscription
# updates — required for correct upgrade/downgrade), [reconcile] (plan-drift check).
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_OPERATE=
STRIPE_PRICE_FRONT_DESK=
# [web] ONLY. Optional one-time setup-fee price ids (added to the first invoice).
# Leave blank to omit. Naming: STRIPE_SETUP_FEE_<PLAN>.
STRIPE_SETUP_FEE_LAUNCH=
STRIPE_SETUP_FEE_OPERATE=
STRIPE_SETUP_FEE_FRONT_DESK=

# [web] ONLY. Days a past_due subscription keeps paid features after its period
# end (grace). Read by getPastDueGraceDays() -> the gating helper (orgCan/orgLimit),
# which runs only in web API routes. Neither worker consumes it. Default 7.
BILLING_PAST_DUE_GRACE_DAYS=

# ─── Billing worker ──────────────────────────────────────────────────────────
# [billing-worker] ONLY (railway.billing-worker.json). All optional; defaults
# shown. The worker's REQUIRED env is NEXT_PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY (same Supabase values the existing workflow worker
# uses) plus the STRIPE_PRICE_* above — no Stripe secret key.
BILLING_EVENT_WORKER_ID=
BILLING_EVENT_WORKER_BATCH_SIZE=10
BILLING_EVENT_WORKER_POLL_MS=2000
BILLING_EVENT_WORKER_STALE_AFTER_SECONDS=900
