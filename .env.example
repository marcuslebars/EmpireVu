# EmpireVu environment variables.
# Copy to .env.local for local development. NEVER commit real values.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used solely by the sanctioned service-role paths
# (lead intake, public booking, Telnyx voice routes).
SUPABASE_SERVICE_ROLE_KEY=
# [gen:types] Remote type generation without Docker: `npm run gen:types:remote`
# reads these from .env.local (git-ignored) and runs against the hosted project.
# PROJECT_REF is the dashboard's Reference ID; generate ACCESS_TOKEN in Supabase →
# Account → Access Tokens. Tooling-only — not read by the app at runtime.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ─── Mobile app (iOS + Android) ──────────────────────────────────────────────
# See mobile/README.md. All optional: without push credentials no pushes are sent.
# Extra origins allowed to call /api cross-origin with a Bearer token, comma-separated.
# capacitor://localhost and https://localhost are always allowed.
MOBILE_APP_ORIGINS=
# APNs token auth (.p8). APNS_PRIVATE_KEY is the key file contents; "\n" escapes are OK.
# APNS_PRODUCTION=true for TestFlight/App Store builds, false for Xcode debug builds.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.empirevu.app
APNS_PRODUCTION=true
# Firebase service-account JSON (single line) for Android pushes via FCM HTTP v1.
FCM_SERVICE_ACCOUNT_JSON=

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL, e.g. https://empirevu.com. Used to build self-booking links, and by
# [web] /api/public/forms/* to recognise the hosted lead page as same-origin (no new var).
# Must be set on BOTH the web and worker services.
APP_BASE_URL=
# Optional API origin for Retell readiness checks when the API and app hosts differ.
# Set on the API and any digest worker; defaults to APP_BASE_URL for single-host deployments.
# Example: https://api.empirevu.com. Does not change customer-facing links.
RETELL_PUBLIC_BASE_URL=
# Defaults to America/Toronto when unset.
BUSINESS_TIMEZONE=

# ─── Lead intake ─────────────────────────────────────────────────────────────
# Organization slug that inbound leads are pinned to (default: a1-group).
LEAD_INTAKE_ORG_SLUG=

# ─── Abuse controls (Task 5) ─────────────────────────────────────────────────
# Cloudflare Turnstile protects the public booking + waitlist forms. Both keys come
# from ONE Turnstile widget (dash.cloudflare.com → Turnstile → Add widget); add every
# form hostname to that widget (app.empirevu.com AND empirevu.com/www).
#
# FAIL-OPEN UNTIL SET: with TURNSTILE_SECRET_KEY unset, verification is skipped (a
# warning is logged) so nothing breaks before you provision it. Once set, a missing or
# invalid token is rejected — so render the widget (VITE_TURNSTILE_SITE_KEY) on BOTH
# forms, including the empirevu.com waitlist (separate empirevu-site repo), BEFORE you
# set the secret here. Rate limiting + honeypot + timing protect the forms regardless.
#
# Website lead forms (/f/:key, /embed/v1.js): instant-reply SMS / auto-call automations
# only run for a form lead whose Turnstile check ACTUALLY verified — set the pair below in
# production. Without them form leads still land + alert the owner (no paid actions).
# Client-safe site key ([web] SPA booking form). VITE_-prefixed by design.
VITE_TURNSTILE_SITE_KEY=
# Server-only secret ([web]). NEVER VITE_/NEXT_PUBLIC_ prefixed.
TURNSTILE_SECRET_KEY=
# SMS throttle for unauthenticated-sourced triggers (public form / public booking) in the
# paid-action guard — read where workflow actions execute: [worker] (workflow-event-worker)
# and [web] (workflow run-now / run-test routes). Defaults shown.
# Hours before the same phone can get another such SMS:
UNAUTH_SMS_COOLDOWN_HOURS=24
# Max sent SMS (all sources) per company in 24h for such a trigger to still send:
UNAUTH_SMS_DAILY_CAP=100
# The DB-backed rate limiter needs no env (it uses SUPABASE_SERVICE_ROLE_KEY). The
# per-org daily cap on unauthenticated-sourced outbound AI calls defaults to 20 and is
# overridden per org via feature_flags.limit_value for feature `public_outbound_calls_daily`.

# ─── Telnyx Voice AI Assistant ───────────────────────────────────────────────
# See docs/telnyx-integration.md for the endpoint URLs and portal setup.
#
# Shared secret Telnyx must send as the `x-empirevu-telnyx-secret` header on all
# four endpoints. Requests without an exact match are rejected with 401.
TELNYX_WEBHOOK_SECRET=
# Company (brand) UUID used when the dialled number isn't mapped in
# `telnyx_numbers`. Without it, an unmapped number resolves to no tenant.
TELNYX_DEFAULT_TENANT_ID=
# `true` logs full raw request payloads so field names can be confirmed on first
# deploy. Turn OFF afterwards — payloads contain caller PII.
TELNYX_DEBUG_PAYLOADS=false
# Booking deposit. A BUSINESS RULE, not pricing-engine output — the engine has no
# deposit concept. Flat cents (default 10000 = $100); TELNYX_DEPOSIT_PERCENT wins
# if both are set.
TELNYX_DEPOSIT_CENTS=10000
TELNYX_DEPOSIT_PERCENT=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Required on BOTH web and worker (the ai_analyze workflow action runs on the worker).
ANTHROPIC_API_KEY=
# AI model per surface (Task 6) — env-overridable so a surface can move to a smaller,
# cheaper model without a code change. Defaults are the current values (claude-opus-5).
AI_MODEL_DRAFTS=
AI_MODEL_WORKFLOWS=
# AI token pricing for usage cost ESTIMATES (USD per million tokens). Defaults are Opus
# 5 list price: input 5.00, output 25.00, cache-read 0.50, cache-write 6.25. If you
# point AI_MODEL_* at a cheaper model, set these to that model's rates too.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_CACHE_READ_PER_MTOK=
AI_PRICE_CACHE_WRITE_PER_MTOK=

# ─── Internal ops (Task 6) ───────────────────────────────────────────────────
# Bearer token gating the cross-tenant cost-vs-MRR report at GET /api/ops/tenant-costs
# (the app has no platform-admin identity, so this is token-gated like the waitlist
# admin read). Unset → the endpoint returns 503. Call with `Authorization: Bearer <token>`;
# `?format=csv` for a spreadsheet export.
OPS_ADMIN_TOKEN=

# ─── Voice (Cartesia / "Marina") ─────────────────────────────────────────────
# All three required. Needed on BOTH web (manual + quick call) and worker
# (the call_lead workflow action). CARTESIA_FROM_NUMBER_ID is the phone number's
# ID from your Cartesia account — not the phone number itself.
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=

# ─── Outbound email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
# Customer-facing sender for AI-drafted replies.
OUTBOUND_FROM_EMAIL=
OUTBOUND_REPLY_TO=
# Internal lead-notification sender/recipients.
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
OWNER_EMAIL=

# ─── Outbound SMS (Twilio) ───────────────────────────────────────────────────
# All-or-nothing: SMS is disabled unless all three are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Worker ──────────────────────────────────────────────────────────────────
# Optional identifier for the workflow-event worker instance.
WORKFLOW_EVENT_WORKER_ID=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# See docs/billing.md and docs/go-live-phase-1.md for the full per-service setup.
# Phase 1 is TEST MODE only. Each var is tagged with the service(s) that consume
# it (traced from the code, not assumed):
#   [web]             the Next app          — railway.json (npm run start)
#   [billing-worker]  event processor       — railway.billing-worker.json (npm run worker:billing-events)
#   [reconcile]       nightly diff/alert    — railway.billing-reconcile.json (npm run job:billing-reconcile)
#
# SERVER-ONLY SECRETS — never prefix with VITE_/NEXT_PUBLIC_, never log, never
# import into the client bundle.

# [web] (webhook signature verify + checkout/portal API calls) and [reconcile]
# (lists subscriptions). NOT needed by [billing-worker] — it never constructs a
# Stripe client (it only reads the already-stored event payload).
STRIPE_SECRET_KEY=
# [web] ONLY. Webhook endpoint signing secret (whsec_...). `stripe listen` prints
# one for local dev; the dashboard endpoint has its own for prod.
STRIPE_WEBHOOK_SECRET=
# Client-safe. Not consumed anywhere in Phase 1 (no UI); documented for Phase 2.
# The ONLY Stripe key that may carry a VITE_/NEXT_PUBLIC_ prefix.
STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (price_...) — pricing lives in Stripe, never as amounts in
# code. [web] (checkout), [billing-worker] (map price->plan on subscription
# updates — required for correct upgrade/downgrade), [reconcile] (plan-drift check).
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_OPERATE=
STRIPE_PRICE_FRONT_DESK=
# [web] ONLY. Optional one-time setup-fee price ids (added to the first invoice).
# Leave blank to omit. Naming: STRIPE_SETUP_FEE_<PLAN>.
STRIPE_SETUP_FEE_LAUNCH=
STRIPE_SETUP_FEE_OPERATE=
STRIPE_SETUP_FEE_FRONT_DESK=

# [web] ONLY. Days a past_due subscription keeps paid features after its period
# end (grace). Read by getPastDueGraceDays() -> the gating helper (orgCan/orgLimit),
# which runs only in web API routes. Neither worker consumes it. Default 7.
BILLING_PAST_DUE_GRACE_DAYS=

# ─── Billing worker ──────────────────────────────────────────────────────────
# [billing-worker] ONLY (railway.billing-worker.json). All optional; defaults
# shown. The worker's REQUIRED env is NEXT_PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY (same Supabase values the existing workflow worker
# uses) plus the STRIPE_PRICE_* above — no Stripe secret key.
BILLING_EVENT_WORKER_ID=
BILLING_EVENT_WORKER_BATCH_SIZE=10
BILLING_EVENT_WORKER_POLL_MS=2000
BILLING_EVENT_WORKER_STALE_AFTER_SECONDS=900
